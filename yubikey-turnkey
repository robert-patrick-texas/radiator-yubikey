TACACS_KEY="{sec['localhost']['tacacs_key']}"
""" + extra, "0600")
    dirent("anycast", "var/lib/yubikey-anycast", "0700", "root:root")
    f("anycast", "var/lib/yubikey-anycast/key",
      f"user=anycast-{n}\npin={a['pin']}\npublic_id={a['public_id']}\nprivate_id={a['private_id']}\n"
