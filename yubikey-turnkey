def alnum(n):
    return "".join(secrets.choice(ALNUM) for _ in range(n))


def scram(password):
    """A PostgreSQL SCRAM-SHA-256 verifier, which ALTER ROLE ... PASSWORD
    takes instead of the password."""
    salt = secrets.token_bytes(16)
    salted = hashlib.pbkdf2_hmac("sha256", password.encode(), salt, 4096)
    client_key = hmac.new(salted, b"Client Key", "sha256").digest()
    stored_key = hashlib.sha256(client_key).digest()
    server_key = hmac.new(salted, b"Server Key", "sha256").digest()
    b64 = lambda b: base64.b64encode(b).decode()
    return f"SCRAM-SHA-256$4096:{b64(salt)}${b64(stored_key)}:{b64(server_key)}"


def scram_matches(verifier, password):
    m = re.match(r"^SCRAM-SHA-256\$(\d+):([A-Za-z0-9+/=]+)\$([A-Za-z0-9+/=]+):([A-Za-z0-9+/=]+)$", verifier or "")
    if not m:
        return False
    salted = hashlib.pbkdf2_hmac("sha256", password.encode(), base64.b64decode(m[2]), int(m[1]))
    stored = hashlib.sha256(hmac.new(salted, b"Client Key", "sha256").digest()).digest()
    return hmac.compare_digest(base64.b64encode(stored).decode(), m[3])


def openssl(*args, cwd):
    try:
        r = subprocess.run(["openssl", *args], cwd=cwd, capture_output=True, text=True)
    except FileNotFoundError:
        die("openssl not found (it makes the cluster's certificates): sudo apt install openssl")
    if r.returncode != 0:
        die(f"openssl {args[0]} failed: {r.stderr.strip()}")
    return r.stdout


def make_ca():
    with tempfile.TemporaryDirectory() as tmp:
        openssl("req", "-x509", "-newkey", "rsa:3072", "-nodes", "-days", "3650",
                "-subj", "/CN=YubiKey DB cluster CA",
                "-addext", "basicConstraints=critical,CA:TRUE",
                "-addext", "keyUsage=critical,keyCertSign,cRLSign",
                "-keyout", "ca.key", "-out", "ca.crt", cwd=tmp)
        return read(tmp, "ca.key"), read(tmp, "ca.crt")


def make_cert(ca_key, ca_crt, fqdn, ip):
    """A certificate for a server, as the guide's three-site section makes
    them: the server's name and address, for TLS servers and clients."""
    with tempfile.TemporaryDirectory() as tmp:
        write(tmp, "ca.key", ca_key)
        write(tmp, "ca.crt", ca_crt)
        openssl("req", "-newkey", "rsa:3072", "-nodes", "-subj", f"/CN={fqdn}",
                "-addext", f"subjectAltName=DNS:{fqdn},IP:{ip}",
                "-addext", "keyUsage=critical,digitalSignature,keyEncipherment",
                "-addext", "extendedKeyUsage=serverAuth,clientAuth",
                "-keyout", "server.key", "-out", "server.csr", cwd=tmp)
        openssl("x509", "-req", "-in", "server.csr", "-CA", "ca.crt", "-CAkey", "ca.key",
                "-CAcreateserial", "-days", "825", "-copy_extensions", "copy", "-out", "server.crt", cwd=tmp)
        return read(tmp, "server.key"), read(tmp, "server.crt")


def expires_within(crt, days):
    with tempfile.TemporaryDirectory() as tmp:
        write(tmp, "c.crt", crt)
        r = subprocess.run(["openssl", "x509", "-noout", "-in", "c.crt", "-checkend", str(days * 86400)],
                           cwd=tmp, capture_output=True)
        return r.returncode != 0


def read(d, name):
    with open(os.path.join(d, name)) as f:
        return f.read()


def write(d, name, text):
    with open(os.path.join(d, name), "w") as f:
        f.write(text)


def fill_secrets(site, old, renew_certs):
    """The secrets for SITE: those in OLD (secrets.toml), and new ones for
    anything that has none yet. Returns (secrets, what is new)."""
    new = []
    sec = {}

    def get(path, make, check=None, derived=False):
        # A value that isn't valid is an error, unless it is DERIVED from
        # another (a password's SCRAM verifier): then it is made again.
        d, o = sec, old
        for k in path[:-1]:
            d = d.setdefault(k, {})
            o = o.get(k, {}) if isinstance(o, dict) else {}
        k = path[-1]
        v = o.get(k) if isinstance(o, dict) else None
        if v is None or (check is not None and not check(v)):
            if v is not None and not derived:
                raise InputError(f"secrets.toml: {'.'.join(path)}: not valid")
            v = make()
            new.append(".".join(path))
        d[k] = v
        return v

    pw = lambda: alnum(32)
    is_pw = lambda v: isinstance(v, str) and PASSWORD_RE.match(v) is not None
    is_secret = lambda v: isinstance(v, str) and SECRET_RE.match(v) is not None
    for k in ("radiator", "patroni_api", "replication", "rewind"):
        get(["cluster", k], pw, is_pw)
    r = sec["cluster"]["radiator"]
    get(["cluster", "radiator_scram"], lambda: scram(r), lambda v: scram_matches(v, r), derived=True)
    for login in site.admins:
        p = get(["admin", login, "password"], pw, is_pw)
        get(["admin", login, "scram"], lambda: scram(p), lambda v: scram_matches(v, p), derived=True)
    get(["localhost", "secret"], pw, is_secret)
    get(["localhost", "tacacs_key"], pw, is_secret)
    if site.catch_all:
        get(["catch_all", "secret"], pw, is_secret)
        get(["catch_all", "tacacs_key"], pw, is_secret)
    for d in site.devices:
        get(["device", d["address"], "secret"], pw, is_secret)
        get(["device", d["address"], "tacacs_key"], pw, is_secret)
    for sv in site.servers:
        n = sv["name"]
        get(["anycast", n, "public_id"], lambda: "vv" + "".join(secrets.choice(MODHEX) for _ in range(10)),
            lambda v: isinstance(v, str) and re.match(r"^[cbdefghijklnrtuv]{12}$", v) is not None)
        get(["anycast", n, "private_id"], lambda: secrets.token_hex(6),
            lambda v: isinstance(v, str) and re.match(r"^[0-9a-f]{12}$", v) is not None)
        get(["anycast", n, "aes_key"], lambda: secrets.token_hex(16),
            lambda v: isinstance(v, str) and re.match(r"^[0-9a-f]{32}$", v) is not None)
        get(["anycast", n, "pin"], lambda: alnum(20),
            lambda v: isinstance(v, str) and re.match(r"^[A-Za-z0-9]{8,}$", v) is not None)
        get(["anycast", n, "made"], lambda: int(time.time()),
            lambda v: isinstance(v, int) and not isinstance(v, bool) and v > 0)
        get(["anycast", n, "tacacs_password"], pw, is_pw)
    ids = [sec["anycast"][sv["name"]][k] for sv in site.servers for k in ("public_id",)]
    if len(set(ids)) != len(ids):
        raise InputError("secrets.toml: two anycast keys have the same public_id")

    pem = lambda kind: (lambda v: isinstance(v, str) and f"-----BEGIN {kind}" in v)
    ca_key = get(["pki", "ca_key"], lambda: None, pem("PRIVATE KEY"))
    if ca_key is None:          # make the CA (and so every certificate) anew
        ca_key, ca_crt = make_ca()
        sec["pki"]["ca_key"] = ca_key
        sec["pki"]["ca_crt"] = ca_crt
        new.append("pki.ca_crt")
    else:
        ca_crt = get(["pki", "ca_crt"], lambda: None, pem("CERTIFICATE"))
        if ca_crt is None:
            raise InputError("secrets.toml: pki.ca_crt is missing (with pki.ca_key there)")
    for sv in site.servers:
        n = sv["name"]
        san = f"DNS:{sv['fqdn']},IP:{sv['ipv4']}"
        o = old.get("pki", {}).get(n, {}) if isinstance(old.get("pki"), dict) else {}
        same_ca = old.get("pki", {}).get("ca_crt") == ca_crt if isinstance(old.get("pki"), dict) else False
        if (not renew_certs and same_ca and isinstance(o, dict) and o.get("san") == san
                and pem("PRIVATE KEY")(o.get("key")) and pem("CERTIFICATE")(o.get("crt"))):
            sec.setdefault("pki", {})[n] = {"san": san, "key": o["key"], "crt": o["crt"]}
        else:
            key, crt = make_cert(ca_key, ca_crt, sv["fqdn"], sv["ipv4"])
            sec.setdefault("pki", {})[n] = {"san": san, "key": key, "crt": crt}
            new.append(f"pki.{n}")

    # Secrets for devices that are no longer listed are kept, in case they
    # come back.
    for addr, v in (old.get("device") or {}).items():
        if isinstance(v, dict) and addr not in sec.get("device", {}):
            sec.setdefault("device", {})[addr] = v
    return sec, new


def toml_key(k):
    return k if re.match(r"^[A-Za-z0-9_-]+$", k) else '"' + k.replace("\\", "\\\\").replace('"', '\\"') + '"'


def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if "\n" in v:
        assert "'''" not in v
        return "'''\n" + v + "'''"
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'


def dump_secrets(sec, site):
    out = [
        f"# secrets.toml - {HEADER} for {site.src}: every password, key and",
        "# certificate of the deployment. yubikey-turnkey makes what is missing",
        "# and keeps the rest, so keep this file: back it up, readable by you only",
        "# (mode 0600). A device's RADIUS secret or TACACS+ key may be changed by hand",
        "# (8 to 128 printable characters, without spaces, quotes, '\\', '#' or '%');",
        "# remove a value to have a new one made. The anycast keys and the passwords",
        "# are loaded into the database once, when setup.sh first runs.",
    ]

    def emit(d, path):
        scalars = [(k, v) for k, v in d.items() if not isinstance(v, dict)]
        tables = [(k, v) for k, v in d.items() if isinstance(v, dict)]
        if scalars:
            out.append("")
            out.append("[" + ".".join(toml_key(p) for p in path) + "]")
            for k, v in scalars:
                out.append(f"{toml_key(k)} = {toml_value(v)}")
        for k, v in tables:
            emit(v, path + [k])

    for k in ("cluster", "admin", "localhost", "catch_all", "device", "anycast", "pki"):
        if k in sec:
            emit(sec[k], [k])
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------------------
# The output
# ---------------------------------------------------------------------------

class Out:
    """The files to write: path -> (mode, bytes)."""

    def __init__(self):
        self.files = {}

    def add(self, path, text, mode=0o600):
        data = text.encode() if isinstance(text, str) else text
        assert path not in self.files, path
        self.files[path] = (mode, data)


def header(site, what, comment="#"):
    return f"{comment} {what} - {HEADER} {VERSION} from {site.src}.\n"


def env_file(site, title, pairs):
    lines = [f"# {title} - {HEADER} {VERSION} from {site.src}: NAME=value",
             "# lines, which setup.sh reads (never runs as shell code)."]
    for k, v in pairs:
        if isinstance(v, (list, tuple)):
            v = " ".join(str(x) for x in v)
        v = str(v)
        assert '"' not in v and "\n" not in v and "\\" not in v, (k, v)
        lines.append(f'{k}="{v}"')
    return "\n".join(lines) + "\n"


def gen_server(site, sec, out, sv):
    n = sv["name"]
    d = f"{n}/"
    first = sv is site.first
    servers = site.servers
    others = [o for o in servers if o is not sv]
    a = sec["anycast"][n]
    files = []      # the manifest: step kind mode owner policy path

    def f(step, path, text, mode="0644", owner="root:root", policy="replace"):
        out.add(d + "files/" + path, text)
        files.append(f"{step} file {mode} {owner} {policy} {path}")

    def dirent(step, path, mode, owner):
        files.append(f"{step} dir {mode} {owner} - {path}")

    # server.env: what setup.sh needs to know, no secrets.
    out.add(d + "server.env", env_file(site, "server.env", [
        ("VERSION", VERSION),
        ("SITE_NAME", site.name),
        ("NAME", n),
        ("FQDN", sv["fqdn"]),
        ("IPV4", sv["ipv4"]),
        ("IPV6", sv["ipv6"]),
        ("FIRST", site.first["name"]),
        ("SERVERS", [o["name"] for o in servers]),
        ("FQDNS", [o["fqdn"] for o in servers]),
        ("IPV4S", [o["ipv4"] for o in servers]),
        ("ANYCAST4", site.any4),
        ("ANYCAST6", site.any6),
        ("ADMINS", site.admins),
        ("ADMIN_SUBNETS", [str(x) for x in site.admin_nets]),
        ("PARTITION", int(site.partition)),
        ("FIREWALL", int(site.firewall)),
    ]))
    # secrets.env: what setup.sh needs itself (the rest is in files/).
    pairs = [("RADIATOR_PASSWORD", sec["cluster"]["radiator"])]
    if first:
        pairs.append(("RADIATOR_SCRAM", sec["cluster"]["radiator_scram"]))
        for login in site.admins:
            pairs.append((f"ADMIN_SCRAM_{login}", sec["admin"][login]["scram"]))
    out.add(d + "secrets.env", env_file(site, "secrets.env", pairs))
    with open(SETUP_SCRIPT) as fh:
        out.add(d + "setup.sh", fh.read(), 0o700)

    # /etc/hosts: the three servers, IPv4 only.
    out.add(d + "hosts", "".join(f"{o['ipv4']}\t{o['fqdn']} {o['name']}\n" for o in servers))

    # Kernel settings: Radiator listens on the anycast addresses while they
    # aren't on lo.
    f("system", "etc/sysctl.d/60-radiator-anycast.conf",
      header(site, "60-radiator-anycast.conf")
      + "# Radiator listens on the anycast addresses while they aren't on lo.\n"
      + "net.ipv4.ip_nonlocal_bind = 1\nnet.ipv6.ip_nonlocal_bind = 1\n")

    # The cluster's TLS files, as the guide installs them.
    pki = sec["pki"]
    dirent("etcd", "etc/etcd/tls", "0750", "root:etcd")
    f("etcd", "etc/etcd/tls/ca.crt", pki["ca_crt"])
    f("etcd", "etc/etcd/tls/server.crt", pki[n]["crt"])
    f("etcd", "etc/etcd/tls/server.key", pki[n]["key"], "0640", "root:etcd")
    cluster = ",".join(f"{o['name']}=https://{o['ipv4']}:2380" for o in servers)
    f("etcd", "etc/default/etcd", header(site, "etcd") + f"""\
# This server's member of the cluster's etcd. The ETCD_INITIAL_* settings
# count only when the cluster is first made.
ETCD_NAME={n}
ETCD_DATA_DIR=/var/lib/etcd/default
ETCD_LISTEN_PEER_URLS=https://{sv['ipv4']}:2380
ETCD_LISTEN_CLIENT_URLS=https://{sv['ipv4']}:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://{sv['ipv4']}:2380
ETCD_ADVERTISE_CLIENT_URLS=https://{sv['ipv4']}:2379
ETCD_INITIAL_CLUSTER={cluster}
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=yubikey-db
ETCD_CERT_FILE=/etc/etcd/tls/server.crt
ETCD_KEY_FILE=/etc/etcd/tls/server.key
ETCD_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CERT_FILE=/etc/etcd/tls/server.crt
ETCD_PEER_KEY_FILE=/etc/etcd/tls/server.key
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_PEER_CLIENT_CERT_AUTH=true
""")

    dirent("patroni", "etc/patroni/tls", "0750", "root:postgres")
    f("patroni", "etc/patroni/tls/ca.crt", pki["ca_crt"])
    f("patroni", "etc/patroni/tls/server.crt", pki[n]["crt"])
    f("patroni", "etc/patroni/tls/server.key", pki[n]["key"], "0640", "root:postgres")
    hba = []
    for o in servers:
        hba += [f"    - hostssl replication replicator {o['ipv4']}/32 scram-sha-256",
                f"    - hostssl postgres    rewinder   {o['ipv4']}/32 scram-sha-256",
                f"    - hostssl yubikey     radiator   {o['ipv4']}/32 scram-sha-256"]
        hba += [f"    - hostssl yubikey     {login} {o['ipv4']}/32 scram-sha-256" for login in site.admins]
    for net in site.admin_nets:
        hba += [f"    - hostssl yubikey     {login} {net} scram-sha-256" for login in site.admins]
    yq = lambda v: "'" + v.replace("'", "''") + "'"
    c = sec["cluster"]
    f("patroni", PATRONI_CONF, header(site, "18-main.yml") + f"""\
# The Debian helper scripts below take the version and cluster from the scope.
scope: 18-main
namespace: /postgresql-common/
name: {n}

restapi:
  listen: {sv['ipv4']}:8008
  connect_address: {sv['fqdn']}:8008
  certfile: /etc/patroni/tls/server.crt
  keyfile: /etc/patroni/tls/server.key
  cafile: /etc/patroni/tls/ca.crt
  authentication:
    username: patroni
    password: {yq(c['patroni_api'])}

ctl:
  cacert: /etc/patroni/tls/ca.crt
  certfile: /etc/patroni/tls/server.crt
  keyfile: /etc/patroni/tls/server.key

etcd3:
  hosts: {','.join(o['ipv4'] + ':2379' for o in servers)}
  protocol: https
  cacert: /etc/patroni/tls/ca.crt
  cert: /etc/patroni/tls/server.crt
  key: /etc/patroni/tls/server.key

bootstrap:
  method: pg_createcluster
  pg_createcluster:
    command: /usr/share/patroni/pg_createcluster_patroni
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    synchronous_mode: quorum
    synchronous_node_count: 1
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        ssl: 'on'
        ssl_cert_file: /etc/patroni/tls/server.crt
        ssl_key_file: /etc/patroni/tls/server.key
        max_slot_wal_keep_size: {site.wal_keep}

postgresql:
  create_replica_method:
    - pg_clonecluster
  pg_clonecluster:
    command: /usr/share/patroni/pg_clonecluster_patroni
  listen: '*:5432'
  connect_address: {sv['fqdn']}:5432
  # Patroni's own connections to this server use its socket: TLS with
  # verify-full fails for "localhost".
  use_unix_socket: true
  use_unix_socket_repl: true
  data_dir: /var/lib/postgresql/18/main
  bin_dir: /usr/lib/postgresql/18/bin
  config_dir: /etc/postgresql/18/main
  pgpass: /var/lib/postgresql/18-main.pgpass
  authentication:
    superuser:
      username: postgres
    replication:
      username: replicator
      password: {yq(c['replication'])}
      sslmode: verify-full
      sslrootcert: /etc/patroni/tls/ca.crt
    rewind:
      username: rewinder
      password: {yq(c['rewind'])}
      sslmode: verify-full
      sslrootcert: /etc/patroni/tls/ca.crt
  parameters:
    unix_socket_directories: /var/run/postgresql
    logging_collector: 'on'
    log_directory: /var/log/postgresql
    log_filename: postgresql-18-main.log
  pg_hba:
    - local   all         all                     peer
    - local   replication replicator              scram-sha-256
{chr(10).join(hba)}

watchdog:
  mode: off

tags:
  failover_priority: {1 if sv['last_resort'] else 2}
""", "0640", "root:postgres")
    f("patroni", "etc/systemd/system/patroni@18-main.service.d/restart.conf",
      header(site, "restart.conf")
      + "# Debian's unit leaves Patroni stopped if it crashes, with PostgreSQL\n"
      + "# running unattended: restart it instead.\n[Service]\nRestart=on-failure\n")

    # Radiator: radiator-groups.example.conf, with this server's addresses
    # and the secret and key of <Client 127.0.0.1>.
    f("radiator", "etc/radiator/pg-ca.crt", pki["ca_crt"])
    conf = radiator_conf(site, sec, sv)
    f("radiator", "etc/radiator/radiator.conf", conf, "0640", "root:radiator")
    dirent("radiator", "etc/radiator/clients.d", "0750", "root:radiator")
    for g in site.device_groups:
        body = header(site, f"{g}.conf") + f"# The devices in device group {g}.\n"
        for dv in site.devices:
            if dv["group"] != g:
                continue
            ds = sec["device"][dv["address"]]
            body += "\n" + (f"# {dv['name']}\n" if dv["name"] else "") + f"""\
<Client {dv['address']}>
    Identifier     {g}
    Secret         {ds['secret']}
    TACACSPLUSKey  {ds['tacacs_key']}
</Client>
"""
        f("radiator", f"etc/radiator/clients.d/{g}.conf", body, "0640", "root:radiator")
    if site.catch_all:
        f("radiator", "etc/radiator/clients.d/catch-all.conf",
          header(site, "catch-all.conf") + f"""\
# Every device that isn't listed, in device group {site.catch_all_group}.
<Client DEFAULT>
    Identifier     {site.catch_all_group}
    Secret         {sec['catch_all']['secret']}
    TACACSPLUSKey  {sec['catch_all']['tacacs_key']}
</Client>
""", "0640", "root:radiator")

    # Partition mode.
    if site.partition:
        f("partition", "etc/radiator/partition.conf", header(site, "partition.conf") + f"""\
# Settings for yubikey-partition.sh (see yubikey-partition.example.conf).
