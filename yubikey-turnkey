    for sv in site.servers:
        if expires_within(sec["pki"][sv["name"]]["crt"], 60):
            note(f"warning: the certificate of {sv['name']} expires within 60 days: "
                 f"run {PROG} --renew-certs, then setup.sh on every server")
    if expires_within(sec["pki"]["ca_crt"], 365):
        note("warning: the cluster's CA certificate expires within a year")
    return 0


if __name__ == "__main__":
    sys.exit(main())
