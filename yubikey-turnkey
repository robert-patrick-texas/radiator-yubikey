      f"user=svc.anycast-{n}\npassword={a['tacacs_password']}\n", "0600", "root:root", "keep")
    f("anycast", "etc/frr/frr.conf", frr_conf(site, sv), "0640", "frr:frr")

    # The firewall.
    v4, v6 = firewall(site, sv)
    f("firewall", "etc/iptables/rules.v4", v4)
    f("firewall", "etc/iptables/rules.v6", v6)

    # The database's first contents, loaded by the first server.
    if first:
        rows = ["username,public_id,private_id,aes_key,password,active"]
        svc = []
        for o in servers:
            k = sec["anycast"][o["name"]]
            rows.append(f"anycast-{o['name']},{k['public_id']},{k['private_id']},{k['aes_key']},{k['pin']},1")
            svc.append(f"svc.anycast-{o['name']}\t{k['tacacs_password']}")
        out.add(d + "db/anycast.csv", "\n".join(rows) + "\n")
        out.add(d + "db/services", "\n".join(svc) + "\n")
        lines = [f"# {HEADER} {VERSION} from {site.src}: the groups setup.sh creates",
                 "# (each once), as tab-separated lines: group NAME LABEL, access NAME",
                 "# DEVICE_GROUP LEVEL REPLY, rule NAME DEVICE_GROUP RULE."]
        for g in site.groups:
            lines.append(f"group\t{g['name']}\t{g['label']}")
            for ac in g["access"]:
                lines.append(f"access\t{g['name']}\t{ac['devices']}\t{ac['level']}\t{ac['reply']}")
                for r in ac["rules"]:
                    lines.append(f"rule\t{g['name']}\t{ac['devices']}\t{r}")
        out.add(d + "db/groups", "\n".join(lines) + "\n")

    out.add(d + "files.list", "\n".join([
        f"# files.list - {HEADER} {VERSION} from {site.src}: the files setup.sh",
        "# installs from files/, as STEP KIND MODE OWNER:GROUP POLICY PATH. POLICY",
        "# replace: whenever they differ; keep: only when the file is missing (the",
        "# anycast check changes its own)."] + files) + "\n")


def radiator_conf(site, sec, sv):
    try:
        with open(GROUPS_CONF) as fh:
            conf = fh.read()
    except OSError as e:
        die(f"cannot read {GROUPS_CONF}: {e.strerror}")

    def sub(old, new):
        nonlocal conf
        if conf.count(old) != 1:
            die(f"{GROUPS_CONF} doesn't have the line '{old.strip()}' once")
        conf = conf.replace(old, new)

    sub("#BindAddress     127.0.0.1, 203.0.113.33, ipv6:2001:db8:33::33, 192.0.2.153, ipv6:2001:db8:153::153\n",
        f"BindAddress     127.0.0.1, {sv['ipv4']}, ipv6:{sv['ipv6']}, {site.any4}, ipv6:{site.any6}\n")
    sub("    Secret         local-test-secret\n", f"    Secret         {sec['localhost']['secret']}\n")
    sub("    TACACSPLUSKey  local-test-key\n", f"    TACACSPLUSKey  {sec['localhost']['tacacs_key']}\n")
    sub("# This server itself, for tests with radpwtst and the anycast check. Change\n# the secret and the key.\n",
        "# This server itself, for tests with radpwtst and the anycast check.\n")
    return (header(site, "radiator.conf")
            + f"# Radiator on {sv['name']}: radiator-groups.example.conf, with this server's\n"
            + "# addresses and the secret and key of <Client 127.0.0.1>. setup.sh installs it\n"
            + "# again whenever it differs: change site.toml instead.\n#\n" + conf)


def frr_conf(site, sv):
    lines = [header(site, "frr.conf", "!").rstrip("\n"),
             "frr defaults traditional",
             f"hostname {sv['name']}",
             "log syslog informational",
             "!",
             f"ip prefix-list RADIUS-ANYCAST seq 10 permit {site.any4}/32",
             f"ipv6 prefix-list RADIUS-ANYCAST seq 10 permit {site.any6}/128",
             "!",
             "route-map RADIUS-ANYCAST permit 10",
             " match ip address prefix-list RADIUS-ANYCAST",
             "exit",
             "route-map RADIUS-ANYCAST permit 20",
             " match ipv6 address prefix-list RADIUS-ANYCAST",
             "exit",
             "route-map NOTHING deny 10",
             "exit",
             "!",
             f"router bgp {site.asn}",
             f" bgp router-id {sv['ipv4']}",
             " no bgp default ipv4-unicast"]
    for r in sv["routers"]:
        for a in (r["ipv4"], r["ipv6"]):
            lines += [f" neighbor {a} remote-as {r['asn']}", f" neighbor {a} description {r['name']}",
                      f" neighbor {a} bfd"]
    for af, key, net in (("ipv4", "ipv4", f"{site.any4}/32"), ("ipv6", "ipv6", f"{site.any6}/128")):
        lines += [" !", f" address-family {af} unicast", f"  network {net}"]
        for r in sv["routers"]:
            a = r[key]
            lines += [f"  neighbor {a} activate", f"  neighbor {a} route-map NOTHING in",
                      f"  neighbor {a} route-map RADIUS-ANYCAST out"]
        lines.append(" exit-address-family")
    lines.append("exit")
    return "\n".join(lines) + "\n"


def firewall(site, sv):
    rules = {4: [], 6: []}
    any_ = {4: site.any4, 6: site.any6}
    host = {4: 32, 6: 128}

    def add(v, rule):
        rules[v].append(rule)

    for v in (4, 6):
        add(v, "# This server's own connections, and their replies")
        add(v, "-A INPUT -i lo -j ACCEPT")
        add(v, "-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT")
        add(v, "-A INPUT -m conntrack --ctstate INVALID -j DROP")
    add(4, "-A INPUT -p icmp -j ACCEPT")
    add(4, "-A INPUT -p udp --sport 67 --dport 68 -j ACCEPT")
    add(6, "-A INPUT -p ipv6-icmp -j ACCEPT")
    add(6, "-A INPUT -s fe80::/10 -p udp --sport 547 --dport 546 -j ACCEPT")
    for v in (4, 6):
        add(v, "# The devices: RADIUS and TACACS+ to the anycast addresses")
    if site.catch_all:
        for v in (4, 6):
            add(v, f"-A INPUT -d {any_[v]}/{host[v]} -p udp -m multiport --dports 1812,1813 -j ACCEPT")
            add(v, f"-A INPUT -d {any_[v]}/{host[v]} -p tcp --dport 49 -j ACCEPT")
    else:
        for dv in site.devices:
            v = dv["net"].version
            src = dv["net"].with_prefixlen
            add(v, f"-A INPUT -s {src} -d {any_[v]}/{host[v]} -p udp -m multiport --dports 1812,1813 -j ACCEPT")
            add(v, f"-A INPUT -s {src} -d {any_[v]}/{host[v]} -p tcp --dport 49 -j ACCEPT")
    add(4, "# The three servers: etcd, PostgreSQL, Patroni")
    for o in site.servers:
        add(4, f"-A INPUT -s {o['ipv4']}/32 -p tcp -m multiport --dports 2379,2380,5432,8008 -j ACCEPT")
    for v in (4, 6):
        add(v, "# The admins: SSH, PostgreSQL, Patroni's REST API")
    for net in site.admin_nets:
        add(net.version, f"-A INPUT -s {net.with_prefixlen} -p tcp -m multiport --dports 22,5432,8008 -j ACCEPT")
    for v in (4, 6):
        add(v, "# This server's routers: BGP, BFD")
    for r in sv["routers"]:
        for v, a in ((4, r["ipv4"]), (6, r["ipv6"])):
            add(v, f"-A INPUT -s {a}/{host[v]} -p tcp --dport 179 -j ACCEPT")
            add(v, f"-A INPUT -s {a}/{host[v]} -p udp --dport 3784 -j ACCEPT")
    out = {}
    for v in (4, 6):
        out[v] = (header(site, f"rules.v{v}") + f"""\
# The firewall of {sv['name']} (IPv{v}), loaded by netfilter-persistent at boot.
# setup.sh installs it again whenever it differs: change site.toml instead.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
""" + "\n".join(rules[v]) + "\nCOMMIT\n")
    return out[4], out[6]


