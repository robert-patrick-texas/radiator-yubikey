#!/usr/bin/env python3
#
# yubikey-turnkey - Make everything that sets up a three-site deployment of
#                   Radiator with the YubiKey database, from one input file.
#
# VERSION
#   In the file VERSION, next to this script; -V shows it.
#
# WHAT IT DOES
#   Reads site.toml (see site.example.toml): the three servers, their
#   routers, the anycast address pair, the devices and their device groups,
#   the groups, and the admins. It holds no secrets: every password, key and
#   certificate is made once, in secrets.toml next to site.toml (mode 0600),
#   and taken from there on every later run, so the same input always gives
#   the same output. Then it writes, in out/ next to site.toml:
#     SERVER/          one folder per server, to copy to it and run there:
#                      setup.sh, its settings (server.env), the files it
#                      installs (files/), and on the first server the
#                      database's first contents (db/)
#     admin/           for the admins' machines: the cluster's CA
#                      certificate, PostgreSQL settings, ~/.pgpass lines
#     runbook.md       the order to do things in
#     routers.md       what each site's router needs
#     devices.md       what each device needs: the anycast addresses, its
#                      RADIUS secret and TACACS+ key (mode 0600)
#   It removes the files it wrote before and no longer writes; other files
#   in out/ (such as the packages copied next to setup.sh) stay.
#
# USAGE
#   yubikey-turnkey [OPTIONS] SITE.toml
#
# OPTIONS
#   -o, --out DIR        Write to DIR (default: out/ next to SITE.toml)
#   -s, --secrets FILE   The secrets (default: secrets.toml next to SITE.toml)
#   -p, --packages DIR   Copy Radiator's packages (radiator_*_all.deb or
#                        radiator-locked_*_all.deb, radiator-radius-utilxs_*.deb),
#                        and radiator-yubikey_VERSION_all.deb with install.sh,
#                        from DIR into each server's folder
#   -n, --check          Change nothing: check the input, and whether out/ and
#                        secrets.toml are up to date
#   --renew-certs        New certificates for the three servers (the CA stays)
#   -h, --help, -V, --version
#
# EXIT STATUS
#   0 done (--check: up to date); 1 --check: something would change; 2 an
#   error in the input or the options.
#
# PREREQUISITES
#   Python 3.11 or later (tomllib), and openssl (for the certificates).

import argparse
import base64
import hashlib
import hmac
import ipaddress
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import time
import tomllib

PROG = os.path.basename(sys.argv[0]) or "yubikey-turnkey"
HERE = os.path.dirname(os.path.realpath(__file__))
try:
    with open(os.path.join(HERE, "VERSION")) as f:
        VERSION = f.read().strip()
except OSError:
    VERSION = "unknown"

SETUP_SCRIPT = os.path.join(HERE, "yubikey-turnkey-setup.sh")
GROUPS_CONF = os.path.join(HERE, "radiator-groups.example.conf")

PG = "18"                       # Ubuntu 26.04's PostgreSQL
PATRONI_CONF = "etc/patroni/18-main.yml"
ALNUM = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
MODHEX = "cbdefghijklnrtuv"
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")          # a server's host name
GROUP_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")          # yubikey-db.sh's group names
LOGIN_RE = re.compile(r"^[a-z_][a-z0-9_]{0,62}$")         # a PostgreSQL role
FQDN_RE = re.compile(r"^(?=.{1,253}$)([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$")
# Secrets that may be typed into secrets.toml by hand (a device's existing
# RADIUS secret): printable, without spaces, quotes, backslashes, '#' or '%'
# (which Radiator's configuration would read as a comment or a special
# character), or '`' and '|' (which the device sheet's tables use).
SECRET_RE = re.compile(r"^[A-Za-z0-9!$&()*+,./:;<=>?@\[\]^_{}~-]{8,128}$")
PASSWORD_RE = re.compile(r"^[A-Za-z0-9]{16,128}$")
RESERVED_GROUPS = {"localhost", "*", "anycast-check"}
RULE_RE = re.compile(r"^(permit|permitreplace|deny) \S")
HEADER = "Made by yubikey-turnkey"


class InputError(Exception):
    pass


def die(msg, code=2):
    print(f"{PROG}: error: {msg}", file=sys.stderr)
    sys.exit(code)


def note(msg):
    sys.stdout.flush()
    print(f"{PROG}: {msg}", file=sys.stderr)


# ---------------------------------------------------------------------------
# The input
# ---------------------------------------------------------------------------

class Site:
    """site.toml, checked."""


class Missing(dict):
    """A table that site.toml lacks: its settings aren't reported missing too."""


def check_site(path):
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")
    except tomllib.TOMLDecodeError as e:
        die(f"{path}: {e}")

    errors = []
    src = os.path.basename(path)

    def err(where, msg):
        errors.append(f"{src}: {where}: {msg}")

    def table(d, key, where, required=True):
        v = d.get(key)
        if v is None:
            if required:
                err(where or key, "missing")
            return Missing()
        if not isinstance(v, dict):
            err(f"{where}{key}", "must be a table")
            return Missing()
        return v

    def known(d, keys, where):
        for k in d:
            if k not in keys:
                err(f"{where}{k}", "unknown setting")

    def text(d, key, where, required=True, pattern=None, what=None, default=None):
        v = d.get(key)
        if v is None:
            if required and not isinstance(d, Missing):
                err(f"{where}{key}", "missing")
            return default
        if not isinstance(v, str):
            err(f"{where}{key}", "must be a string")
            return default
        if pattern and not pattern.match(v):
            err(f"{where}{key}", f"'{v}' is not {what}")
            return default
        return v

    def integer(d, key, where, lo, hi, default=None, required=False):
        v = d.get(key)
        if v is None:
            if required and not isinstance(d, Missing):
                err(f"{where}{key}", "missing")
            return default
        if not isinstance(v, int) or isinstance(v, bool) or not lo <= v <= hi:
            err(f"{where}{key}", f"must be a whole number from {lo} to {hi}")
            return default
        return v

    def boolean(d, key, where, default):
        v = d.get(key, default)
        if not isinstance(v, bool):
            err(f"{where}{key}", "must be true or false")
            return default
        return v

    def address(d, key, where, version, required=True):
        v = text(d, key, where, required)
        if v is None:
            return None
        try:
            a = ipaddress.ip_address(v)
        except ValueError:
            err(f"{where}{key}", f"'{v}' is not an IPv{version} address")
            return None
        if a.version != version:
            err(f"{where}{key}", f"'{v}' is not an IPv{version} address")
            return None
        if a.is_loopback or a.is_unspecified or a.is_multicast or a.is_link_local:
            err(f"{where}{key}", f"'{v}' can't be used here")
            return None
        return str(a)

    s = Site()
    known(data, {"site", "server", "anycast", "cluster", "admin", "partition", "firewall",
                 "catch_all", "device", "group"}, "")

    t = table(data, "site", "[site]")
    known(t, {"name", "service_name"}, "site.")
    s.name = text(t, "name", "site.", pattern=re.compile(r'^[^"\\\n\r\t`$]{1,80}$'),
                  what="a title of 1 to 80 characters without quotes, '$' or '`'", default="")
    s.service_name = text(t, "service_name", "site.", required=False, pattern=FQDN_RE,
                          what="a DNS name")

    s.servers = []
    servers = data.get("server")
    if not isinstance(servers, list) or len(servers) != 3:
        err("[[server]]", "there must be exactly three servers")
        servers = servers if isinstance(servers, list) else []
    asns = set()
    for i, sv in enumerate(servers):
        w = f"server[{i + 1}]."
        if not isinstance(sv, dict):
            err(w, "must be a table")
            continue
        known(sv, {"name", "fqdn", "ipv4", "ipv6", "last_resort", "router"}, w)
        srv = {
            "name": text(sv, "name", w, pattern=NAME_RE,
                         what="a host name (lower-case letters, digits and '-', up to 31)"),
            "fqdn": text(sv, "fqdn", w, pattern=FQDN_RE, what="a fully qualified DNS name"),
            "ipv4": address(sv, "ipv4", w, 4),
            "ipv6": address(sv, "ipv6", w, 6),
            "last_resort": boolean(sv, "last_resort", w, False),
            "routers": [],
        }
        routers = sv.get("router")
        if not isinstance(routers, list) or not 1 <= len(routers) <= 2:
            err(f"{w}router", "each server needs one or two [[server.router]]")
            routers = routers if isinstance(routers, list) else []
        for j, r in enumerate(routers):
            rw = f"{w}router[{j + 1}]."
            if not isinstance(r, dict):
                err(rw, "must be a table")
                continue
            known(r, {"name", "ipv4", "ipv6", "asn"}, rw)
            rt = {
                "name": text(r, "name", rw, required=False, pattern=re.compile(r"^[A-Za-z0-9._-]{1,63}$"),
                             what="a name (letters, digits and . _ -)"),
                "ipv4": address(r, "ipv4", rw, 4),
                "ipv6": address(r, "ipv6", rw, 6),
                "asn": integer(r, "asn", rw, 1, 4294967295, required=True),
            }
            if rt["name"] is None:
                rt["name"] = f"{srv['name'] or 'server'}-router{j + 1}"
            asns.add(rt["asn"])
            srv["routers"].append(rt)
        s.servers.append(srv)
    if len(s.servers) == 3:
        for key in ("name", "fqdn", "ipv4", "ipv6"):
            vals = [sv[key] for sv in s.servers if sv[key]]
            for v in set(vals):
                if vals.count(v) > 1:
                    err("[[server]]", f"{key} '{v}' is used twice")
        if s.servers[0]["last_resort"]:
            err("server[1].last_resort", "the first server is the usual primary: it can't be the last resort")
        if sum(sv["last_resort"] for sv in s.servers) > 1:
            err("[[server]]", "only one server can be the last resort")
        # A router may serve two sites' servers, with the same AS.
        rasn = {}
        for i, sv in enumerate(s.servers):
            mine = [a for r in sv["routers"] for a in (r["ipv4"], r["ipv6"]) if a]
            for v in set(mine):
                if mine.count(v) > 1:
                    err(f"server[{i + 1}].router", f"address '{v}' is used twice")
            for r in sv["routers"]:
                for a in (r["ipv4"], r["ipv6"]):
                    if a and rasn.setdefault(a, r["asn"]) != r["asn"]:
                        err(f"server[{i + 1}].router", f"router '{a}' has two AS numbers")
        raddrs = set(rasn)
        saddrs = {sv[k] for sv in s.servers for k in ("ipv4", "ipv6")}
        for v in raddrs & saddrs:
            err("[[server.router]]", f"address '{v}' is a server's")

    t = table(data, "anycast", "[anycast]")
    known(t, {"ipv4", "ipv6", "asn", "interval", "renew_days"}, "anycast.")
    s.any4 = address(t, "ipv4", "anycast.", 4)
    s.any6 = address(t, "ipv6", "anycast.", 6)
    s.asn = integer(t, "asn", "anycast.", 1, 4294967295, required=True)
    s.interval = integer(t, "interval", "anycast.", 1, 60)
    s.renew_days = integer(t, "renew_days", "anycast.", 0, 3650)
    if s.asn is not None and s.asn in asns:
        err("anycast.asn", f"{s.asn} is a router's AS too: the servers need an AS of their own")
    for a in (s.any4, s.any6):
        if a and any(a in (sv["ipv4"], sv["ipv6"]) for sv in s.servers):
            err("[anycast]", f"'{a}' is a server's own address")

    t = table(data, "cluster", "[cluster]", required=False)
    known(t, {"wal_keep"}, "cluster.")
    s.wal_keep = text(t, "wal_keep", "cluster.", required=False, pattern=re.compile(r"^[1-9][0-9]{0,5}(MB|GB|TB)$"),
                      what="a size such as 8GB", default="8GB")

    t = table(data, "admin", "[admin]")
    known(t, {"logins", "subnets"}, "admin.")
    s.admins = []
    logins = t.get("logins")
    if isinstance(t, Missing):
        pass
    elif not isinstance(logins, list) or not logins or not all(isinstance(x, str) for x in logins):
        err("admin.logins", "must be a list of one or more PostgreSQL role names")
    else:
        for x in logins:
            if not LOGIN_RE.match(x) or x in ("postgres", "radiator", "replicator", "rewinder", "yubikey_admin"):
                err("admin.logins", f"'{x}' can't be an admin's login (lower-case letters, digits and '_'; "
                    "not postgres, radiator, replicator, rewinder or yubikey_admin)")
            elif x in s.admins:
                err("admin.logins", f"'{x}' is listed twice")
            else:
                s.admins.append(x)
    s.admin_nets = subnets(t.get("subnets"), "admin.subnets", err, required=not isinstance(t, Missing))

    t = table(data, "partition", "[partition]", required=False)
    known(t, {"enabled"}, "partition.")
    s.partition = boolean(t, "enabled", "partition.", True)
    t = table(data, "firewall", "[firewall]", required=False)
    known(t, {"enabled"}, "firewall.")
    s.firewall = boolean(t, "enabled", "firewall.", True)

    t = table(data, "catch_all", "[catch_all]", required=False)
    known(t, {"enabled", "group"}, "catch_all.")
    s.catch_all = boolean(t, "enabled", "catch_all.", True)
    s.catch_all_group = text(t, "group", "catch_all.", required=False, pattern=GROUP_RE,
                             what="a device group name (letters, digits and . _ -)", default="unlisted")

    s.devices = []
    devices = data.get("device", [])
    if not isinstance(devices, list):
        err("[[device]]", "must be a list of tables")
        devices = []
    seen = {}
    for i, d in enumerate(devices):
        w = f"device[{i + 1}]."
        if not isinstance(d, dict):
            err(w, "must be a table")
            continue
        known(d, {"address", "group", "name"}, w)
        a = text(d, "address", w)
        net = None
        if a is not None:
            try:
                net = ipaddress.ip_network(a, strict=True)
            except ValueError:
                err(f"{w}address", f"'{a}' is not an address or a subnet (with the host bits 0)")
        if net is not None and (net.network_address.is_loopback or net.network_address.is_unspecified
                                or net.prefixlen == 0):
            err(f"{w}address", f"'{a}' can't be a device (the catch-all takes every device that isn't listed)")
            net = None
        g = text(d, "group", w, pattern=GROUP_RE, what="a device group name (letters, digits and . _ -)")
        if g in RESERVED_GROUPS:
            err(f"{w}group", f"'{g}' is reserved")
        if g is not None and s.catch_all and g == s.catch_all_group:
            err(f"{w}group", f"'{g}' is the catch-all's device group")
        name = text(d, "name", w, required=False, pattern=re.compile(r"^[^\n\r\t|`]{1,64}$"),
                    what="a name of 1 to 64 characters")
        if net is None:
            continue
        key = net.with_prefixlen if net.prefixlen != net.max_prefixlen else str(net.network_address)
        if key in seen:
            err(f"{w}address", f"'{a}' is listed twice (device {seen[key]})")
            continue
        seen[key] = i + 1
        s.devices.append({"address": key, "net": net, "group": g, "name": name or ""})
    s.device_groups = []
    for d in s.devices:
        if d["group"] and d["group"] not in s.device_groups:
            s.device_groups.append(d["group"])
    if not s.devices and not s.catch_all:
        err("[[device]]", "list the devices, or enable the catch-all client")

    s.groups = []
    groups = data.get("group", [])
    if not isinstance(groups, list):
        err("[[group]]", "must be a list of tables")
        groups = []
    names = set()
    targets = set(s.device_groups) | {"*", "localhost"} | ({s.catch_all_group} if s.catch_all else set())
    for i, g in enumerate(groups):
        w = f"group[{i + 1}]."
        if not isinstance(g, dict):
            err(w, "must be a table")
            continue
        known(g, {"name", "label", "access"}, w)
        name = text(g, "name", w, pattern=GROUP_RE, what="a group name (letters, digits and . _ -)")
        if name == "anycast-check":
            err(f"{w}name", "'anycast-check' is the anycast check's own group")
        elif name in names:
            err(f"{w}name", f"'{name}' is listed twice")
        names.add(name)
        label = text(g, "label", w, required=False, pattern=re.compile(r"^[^\n\r\t]{1,255}$"),
                     what="a label of up to 255 characters", default="")
        access = g.get("access", [])
        if not isinstance(access, list):
            err(f"{w}access", "must be a list")
            access = []
        acc = []
        devs = set()
        for j, a in enumerate(access):
            aw = f"{w}access[{j + 1}]."
            if not isinstance(a, dict):
                err(aw, "must be a table")
                continue
            known(a, {"devices", "level", "reply", "rules"}, aw)
            dg = text(a, "devices", aw)
            if dg is not None and dg not in targets:
                err(f"{aw}devices", f"'{dg}' is not a device group (one of: {', '.join(sorted(targets))})")
            if dg in devs:
                err(f"{aw}devices", f"'{dg}' is listed twice")
            devs.add(dg)
            level = integer(a, "level", aw, 0, 15, required=True)
            reply = text(a, "reply", aw, required=False, pattern=re.compile(r"^[^\n\r\t]{1,1000}$"),
                         what="RADIUS reply attributes", default="")
            rules = a.get("rules", [])
            if not isinstance(rules, list) or not all(isinstance(r, str) for r in rules):
                err(f"{aw}rules", "must be a list of strings")
                rules = []
            for r in rules:
                if not RULE_RE.match(r) or '"' in r or re.search(r"\\[0-7]{3}", r) or re.search(r"[\n\r\t]", r):
                    err(f"{aw}rules", f"'{r}' is not a rule (permit, permitreplace or deny, then patterns; "
                        "no double quotes or octal escapes)")
            acc.append({"devices": dg, "level": level, "reply": reply, "rules": rules})
        s.groups.append({"name": name, "label": label, "access": acc})

    if errors:
        raise InputError("\n".join(errors))
    s.first = s.servers[0]
    s.path = os.path.realpath(path)
    s.src = src
    return s


def subnets(v, where, err, required=False):
    if v is None and not required:
        return []
    if not isinstance(v, list) or not all(isinstance(x, str) for x in v) or (required and not v):
        err(where, "must be a list of subnets (or addresses), such as \"10.9.0.0/24\"")
        return []
    out = []
    for x in v:
        try:
            n = ipaddress.ip_network(x, strict=True)
        except ValueError:
            err(where, f"'{x}' is not a subnet (with the host bits 0) or an address")
            continue
        if n.prefixlen == 0:
            err(where, f"'{x}' is everything")
            continue
        out.append(n)
    return out


