    else:
        for top in sorted({p.split("/")[0] for p in write_ + remove}):
            mine = [p for p in write_ if p.split("/")[0] == top]
            gone = [p for p in remove if p.split("/")[0] == top]
            if mine == [top]:
                print(f"wrote {show(outdir, top)}")
