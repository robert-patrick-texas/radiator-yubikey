def copy_packages(site, out, pkgdir):
    import glob
    want = []
    rad = sorted(glob.glob(os.path.join(pkgdir, "radiator_*_all.deb"))
                 + glob.glob(os.path.join(pkgdir, "radiator-locked_*_all.deb")))
    utilxs = sorted(glob.glob(os.path.join(pkgdir, "radiator-radius-utilxs_*.deb")))
    yk = os.path.join(pkgdir, f"radiator-yubikey_{VERSION}_all.deb")
    inst = os.path.join(pkgdir, "install.sh")
    if len(rad) != 1:
        die(f"{pkgdir} must hold one radiator_*_all.deb (or radiator-locked_*_all.deb), not {len(rad)}")
    if len(utilxs) != 1:
        die(f"{pkgdir} must hold one radiator-radius-utilxs_*.deb, not {len(utilxs)}")
    for p in (yk, inst):
        if not os.path.isfile(p):
            die(f"{pkgdir} has no {os.path.basename(p)} (radiator-yubikey's package and install.sh, version {VERSION})")
    want = rad + utilxs + [yk, inst]
    for o in site.servers:
        for p in want:
            with open(p, "rb") as fh:
                out.add(f"{o['name']}/{os.path.basename(p)}", fh.read(), 0o700 if p == inst else 0o600)


