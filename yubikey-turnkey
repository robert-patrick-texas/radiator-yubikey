MANIFEST = ".turnkey-files"


def compare(outdir, files):
    """What would change in OUTDIR: (paths to write, paths to remove)."""
    write_, remove = [], []
    for path, (mode, data) in sorted(files.items()):
        p = os.path.join(outdir, path)
        try:
            with open(p, "rb") as fh:
                same = fh.read() == data
            same = same and (os.stat(p).st_mode & 0o777) == mode
        except OSError:
            same = False
        if not same:
            write_.append(path)
    try:
        with open(os.path.join(outdir, MANIFEST)) as fh:
            old = [x for x in fh.read().split("\n") if x]
    except OSError:
        old = []
    for path in old:
        if path not in files and os.path.lexists(os.path.join(outdir, path)):
            remove.append(path)
    return write_, remove


def write_out(outdir, files, write_, remove):
    os.makedirs(outdir, mode=0o700, exist_ok=True)
    os.chmod(outdir, 0o700)
    for path in write_:
        mode, data = files[path]
        p = os.path.join(outdir, path)
        os.makedirs(os.path.dirname(p), mode=0o700, exist_ok=True)
        tmp = p + ".new"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, p)
    for path in remove:
        os.remove(os.path.join(outdir, path))
        d = os.path.dirname(os.path.join(outdir, path))
        while d != outdir and os.path.isdir(d) and not os.listdir(d):
            os.rmdir(d)
            d = os.path.dirname(d)
    with open(os.path.join(outdir, MANIFEST + ".new"), "w") as fh:
        fh.write("".join(p + "\n" for p in sorted(files)))
    os.replace(os.path.join(outdir, MANIFEST + ".new"), os.path.join(outdir, MANIFEST))


def show(*parts):
    """A path to print: relative to the current folder when it is in it."""
    p = os.path.join(*parts)
    r = os.path.relpath(p)
    return p if r.startswith("..") else r


def summary(paths):
    """What the new secrets (secrets.toml's paths) are, in words."""
    seen = []
    for p in paths:
        part = p.split(".")
        if part[0] == "device":
            k = "device secrets"
        elif part[0] == "pki":
            k = "the CA" if part[1] in ("ca_key", "ca_crt") else f"{part[1]}'s certificate"
        elif part[0] == "admin":
            k = f"{part[1]}'s " + ("SCRAM verifier" if part[-1] == "scram" else "password")
        elif part[0] == "anycast":
            k = f"{part[1]}'s anycast key"
        elif p == "cluster.radiator_scram":
            k = "radiator's SCRAM verifier"
        else:
            k = p
        if k not in seen:
            seen.append(k)
    return ", ".join(seen)


def save_secrets(path, text):
    tmp = path + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def main():
    ap = argparse.ArgumentParser(
        prog=PROG, add_help=False,
        usage=f"{PROG} [-o DIR] [-s FILE] [-p DIR] [-n] [--renew-certs] SITE.toml",
        description="Make everything that sets up a three-site deployment of Radiator with the YubiKey "
                    "database: one folder per server with its setup.sh, and the hand-off sheets for the "
                    "routers and the devices, from SITE.toml (see site.example.toml).")
    ap.add_argument("site", metavar="SITE.toml", nargs="?")
    ap.add_argument("-o", "--out", metavar="DIR", help="write to DIR (default: out/ next to SITE.toml)")
    ap.add_argument("-s", "--secrets", metavar="FILE",
                    help="the secrets (default: secrets.toml next to SITE.toml)")
    ap.add_argument("-p", "--packages", metavar="DIR",
                    help="copy Radiator's packages, and radiator-yubikey's with install.sh, from DIR "
                         "into each server's folder")
    ap.add_argument("-n", "--check", action="store_true",
                    help="change nothing: check the input, and whether the output is up to date")
    ap.add_argument("--renew-certs", action="store_true", help="new certificates for the three servers")
    ap.add_argument("-h", "--help", action="help", help="show this help")
    ap.add_argument("-V", "--version", action="version", version=f"{PROG} {VERSION}")
    args = ap.parse_args()
    os.umask(0o077)     # everything it writes holds secrets, or sits with them
    if not args.site:
        ap.print_usage(sys.stderr)
        die("name the input file, such as site.toml")
    if args.check and args.renew_certs:
        die("--check changes nothing: not with --renew-certs")

    base = os.path.dirname(os.path.abspath(args.site))
    outdir = os.path.abspath(args.out or os.path.join(base, "out"))
    if not os.path.isfile(SETUP_SCRIPT):
        die(f"{SETUP_SCRIPT} is missing (it comes with {PROG})")
    secpath = args.secrets or os.path.join(base, "secrets.toml")

    try:
        site = check_site(args.site)
    except InputError as e:
        print(e, file=sys.stderr)
        die("nothing written: fix the input first")

    old = {}
    if os.path.exists(secpath):
        st = os.stat(secpath)
        if st.st_mode & 0o077:
            die(f"{secpath} is readable by others (mode {st.st_mode & 0o777:04o}): chmod 600 {secpath}")
        try:
            with open(secpath, "rb") as fh:
                old = tomllib.load(fh)
        except tomllib.TOMLDecodeError as e:
            die(f"{secpath}: {e}")
    try:
        if args.check:
            # What is missing is made, here only, to report it.
            sec, new = fill_secrets(site, old, False) if old else ({}, ["everything"])
        else:
            sec, new = fill_secrets(site, old, args.renew_certs)
    except InputError as e:
        die(str(e))

    if args.check and new:
        print(f"{show(secpath)}: would get new secrets: {summary(new)}")
        return 1

    out = Out()
    for sv in site.servers:
        gen_server(site, sec, out, sv)
    gen_admin(site, sec, out)
    gen_sheets(site, sec, out, args.packages)
    if args.packages:
        copy_packages(site, out, args.packages)

    sectext = dump_secrets(sec, site)
    write_, remove = compare(outdir, out.files)
    if args.check:
        changed = False
        try:
            with open(secpath) as fh:
                if fh.read() != sectext:
                    print(f"{show(secpath)}: would be written again")
                    changed = True
        except OSError:
            changed = True
        for p in write_:
            print(f"{show(outdir, p)}: would be written")
        for p in remove:
