$ yubikey-db.sh -d <WORK>/yubicred.db list
yubikey-db.sh: error: database <WORK>/yubicred.db does not exist; run 'yubikey-db.sh init' first
[exit 1]

$ yubikey-db.sh -d <WORK>/yubicred.db init
yubikey-db.sh: warning: Radiator needs write access to <WORK>/yubicred.db and its directory to update OTP counters; re-run with --owner <radiator-user>[:group] if Radiator does not run as <USER>
Database ready: <WORK>/yubicred.db
[exit 0]

# schema of yubicred.db
CREATE TABLE yubikeys (
    username varchar(255) not null,
    password varchar(64)  not null,
    active   boolean default false,
    created  datetime not null,
    accessed datetime not null,
    tokenId  varchar(60) unique not null,   -- YubiKey public ID (modhex)
    userId   varchar(60) unique not null,   -- YubiKey private ID (hex)
    secret   varchar(60) not null,          -- AES key (base64 or hex)
    counter  int default 0,
    low      int default 0,
    high     int default 0,
    primary key (userId)
);
CREATE INDEX yubikeys_username ON yubikeys (username);
CREATE TRIGGER yubikeys_counters_forward
BEFORE UPDATE OF counter, low ON yubikeys
FOR EACH ROW WHEN NEW.counter < OLD.counter OR (NEW.counter = OLD.counter AND NEW.low <= OLD.low)
BEGIN
    SELECT RAISE(ABORT, 'counter violation: this YubiKey already used this OTP or a later one');
END;

$ yubikey-db.sh -d <WORK>/yubicred.db init
yubikey-db.sh: warning: Radiator needs write access to <WORK>/yubicred.db and its directory to update OTP counters; re-run with --owner <radiator-user>[:group] if Radiator does not run as <USER>
Database ready: <WORK>/yubicred.db
