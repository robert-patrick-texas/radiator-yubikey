-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p ipv6-icmp -j ACCEPT
-A INPUT -s fe80::/10 -p udp --sport 547 --dport 546 -j ACCEPT
# The devices: RADIUS and TACACS+ to the anycast addresses
-A INPUT -d 2001:db8:153::153/128 -p udp -m multiport --dports 1812,1813 -j ACCEPT
-A INPUT -d 2001:db8:153::153/128 -p tcp --dport 49 -j ACCEPT
# The admins: SSH, PostgreSQL, Patroni's REST API
-A INPUT -s 2001:db8:9::/64 -p tcp -m multiport --dports 22,5432,8008 -j ACCEPT
# This server's routers: BGP, BFD
-A INPUT -s 2001:db8:33::1/128 -p tcp --dport 179 -j ACCEPT
-A INPUT -s 2001:db8:33::1/128 -p udp --dport 3784 -j ACCEPT
-A INPUT -s 2001:db8:33::2/128 -p tcp --dport 179 -j ACCEPT
