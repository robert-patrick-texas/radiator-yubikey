--- out/east1/files/etc/default/etcd (600)
# etcd - Made by yubikey-turnkey <VERSION> from site.toml.
# This server's member of the cluster's etcd. The ETCD_INITIAL_* settings
# count only when the cluster is first made.
ETCD_NAME=east1
ETCD_DATA_DIR=/var/lib/etcd/default
ETCD_LISTEN_PEER_URLS=https://192.0.2.31:2380
ETCD_LISTEN_CLIENT_URLS=https://192.0.2.31:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://192.0.2.31:2380
ETCD_ADVERTISE_CLIENT_URLS=https://192.0.2.31:2379
ETCD_INITIAL_CLUSTER=east1=https://192.0.2.31:2380,east2=https://198.51.100.32:2380,west=https://203.0.113.33:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER_TOKEN=yubikey-db
ETCD_CERT_FILE=/etc/etcd/tls/server.crt
ETCD_KEY_FILE=/etc/etcd/tls/server.key
ETCD_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CERT_FILE=/etc/etcd/tls/server.crt
ETCD_PEER_KEY_FILE=/etc/etcd/tls/server.key
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_PEER_CLIENT_CERT_AUTH=true

--- out/east1/files/etc/patroni/18-main.yml (600)
# 18-main.yml - Made by yubikey-turnkey <VERSION> from site.toml.
# The Debian helper scripts below take the version and cluster from the scope.
scope: 18-main
namespace: /postgresql-common/
name: east1

restapi:
  listen: 192.0.2.31:8008
  connect_address: east1.example.com:8008
  certfile: /etc/patroni/tls/server.crt
  keyfile: /etc/patroni/tls/server.key
  cafile: /etc/patroni/tls/ca.crt
  authentication:
    username: patroni
    password: 'LlukyXZKzDJQSDRA0Rv0ChJfxgSRVBw6'

ctl:
  cacert: /etc/patroni/tls/ca.crt
  certfile: /etc/patroni/tls/server.crt
  keyfile: /etc/patroni/tls/server.key

etcd3:
  hosts: 192.0.2.31:2379,198.51.100.32:2379,203.0.113.33:2379
  protocol: https
  cacert: /etc/patroni/tls/ca.crt
  cert: /etc/patroni/tls/server.crt
  key: /etc/patroni/tls/server.key

bootstrap:
  method: pg_createcluster
  pg_createcluster:
    command: /usr/share/patroni/pg_createcluster_patroni
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    synchronous_mode: quorum
    synchronous_node_count: 1
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        ssl: 'on'
        ssl_cert_file: /etc/patroni/tls/server.crt
        ssl_key_file: /etc/patroni/tls/server.key
        max_slot_wal_keep_size: 8GB

postgresql:
  create_replica_method:
    - pg_clonecluster
  pg_clonecluster:
    command: /usr/share/patroni/pg_clonecluster_patroni
  listen: '*:5432'
  connect_address: east1.example.com:5432
  # Patroni's own connections to this server use its socket: TLS with
  # verify-full fails for "localhost".
  use_unix_socket: true
  use_unix_socket_repl: true
  data_dir: /var/lib/postgresql/18/main
  bin_dir: /usr/lib/postgresql/18/bin
  config_dir: /etc/postgresql/18/main
  pgpass: /var/lib/postgresql/18-main.pgpass
  authentication:
    superuser:
      username: postgres
    replication:
      username: replicator
      password: 'RqR5nOeiflu8tsV04HG386wSRB7hMZe0'
      sslmode: verify-full
      sslrootcert: /etc/patroni/tls/ca.crt
    rewind:
      username: rewinder
      password: '69w02QHE5uJIJ1JMmeB5TJ6kaMU5lSrx'
      sslmode: verify-full
      sslrootcert: /etc/patroni/tls/ca.crt
  parameters:
    unix_socket_directories: /var/run/postgresql
    logging_collector: 'on'
    log_directory: /var/log/postgresql
    log_filename: postgresql-18-main.log
  pg_hba:
    - local   all         all                     peer
    - local   replication replicator              scram-sha-256
    - hostssl replication replicator 192.0.2.31/32 scram-sha-256
    - hostssl postgres    rewinder   192.0.2.31/32 scram-sha-256
    - hostssl yubikey     radiator   192.0.2.31/32 scram-sha-256
    - hostssl yubikey     opsadmin 192.0.2.31/32 scram-sha-256
    - hostssl replication replicator 198.51.100.32/32 scram-sha-256
    - hostssl postgres    rewinder   198.51.100.32/32 scram-sha-256
    - hostssl yubikey     radiator   198.51.100.32/32 scram-sha-256
    - hostssl yubikey     opsadmin 198.51.100.32/32 scram-sha-256
    - hostssl replication replicator 203.0.113.33/32 scram-sha-256
    - hostssl postgres    rewinder   203.0.113.33/32 scram-sha-256
    - hostssl yubikey     radiator   203.0.113.33/32 scram-sha-256
    - hostssl yubikey     opsadmin 203.0.113.33/32 scram-sha-256
    - hostssl yubikey     opsadmin 10.9.0.0/24 scram-sha-256
    - hostssl yubikey     opsadmin 2001:db8:9::/64 scram-sha-256

watchdog:
  mode: off

tags:
  failover_priority: 2

--- out/west/files/etc/frr/frr.conf (600)
! frr.conf - Made by yubikey-turnkey <VERSION> from site.toml.
frr defaults traditional
hostname west
log syslog informational
!
ip prefix-list RADIUS-ANYCAST seq 10 permit 192.0.2.153/32
ipv6 prefix-list RADIUS-ANYCAST seq 10 permit 2001:db8:153::153/128
!
route-map RADIUS-ANYCAST permit 10
 match ip address prefix-list RADIUS-ANYCAST
exit
route-map RADIUS-ANYCAST permit 20
 match ipv6 address prefix-list RADIUS-ANYCAST
exit
route-map NOTHING deny 10
exit
!
router bgp 65053
 bgp router-id 203.0.113.33
 no bgp default ipv4-unicast
 neighbor 203.0.113.1 remote-as 64500
 neighbor 203.0.113.1 description west-rtr1
 neighbor 203.0.113.1 bfd
 neighbor 2001:db8:33::1 remote-as 64500
 neighbor 2001:db8:33::1 description west-rtr1
 neighbor 2001:db8:33::1 bfd
 neighbor 203.0.113.2 remote-as 64500
 neighbor 203.0.113.2 description west-rtr2
 neighbor 203.0.113.2 bfd
 neighbor 2001:db8:33::2 remote-as 64500
 neighbor 2001:db8:33::2 description west-rtr2
 neighbor 2001:db8:33::2 bfd
 !
 address-family ipv4 unicast
  network 192.0.2.153/32
  neighbor 203.0.113.1 activate
  neighbor 203.0.113.1 route-map NOTHING in
  neighbor 203.0.113.1 route-map RADIUS-ANYCAST out
  neighbor 203.0.113.2 activate
  neighbor 203.0.113.2 route-map NOTHING in
  neighbor 203.0.113.2 route-map RADIUS-ANYCAST out
 exit-address-family
 !
 address-family ipv6 unicast
  network 2001:db8:153::153/128
  neighbor 2001:db8:33::1 activate
  neighbor 2001:db8:33::1 route-map NOTHING in
  neighbor 2001:db8:33::1 route-map RADIUS-ANYCAST out
  neighbor 2001:db8:33::2 activate
  neighbor 2001:db8:33::2 route-map NOTHING in
  neighbor 2001:db8:33::2 route-map RADIUS-ANYCAST out
 exit-address-family
exit

--- out/west/files/etc/iptables/rules.v4 (600)
# rules.v4 - Made by yubikey-turnkey <VERSION> from site.toml.
# The firewall of west (IPv4), loaded by netfilter-persistent at boot.
# setup.sh installs it again whenever it differs: change site.toml instead.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
# This server's own connections, and their replies
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p icmp -j ACCEPT
-A INPUT -p udp --sport 67 --dport 68 -j ACCEPT
# The devices: RADIUS and TACACS+ to the anycast addresses
-A INPUT -d 192.0.2.153/32 -p udp -m multiport --dports 1812,1813 -j ACCEPT
-A INPUT -d 192.0.2.153/32 -p tcp --dport 49 -j ACCEPT
# The three servers: etcd, PostgreSQL, Patroni
-A INPUT -s 192.0.2.31/32 -p tcp -m multiport --dports 2379,2380,5432,8008 -j ACCEPT
-A INPUT -s 198.51.100.32/32 -p tcp -m multiport --dports 2379,2380,5432,8008 -j ACCEPT
-A INPUT -s 203.0.113.33/32 -p tcp -m multiport --dports 2379,2380,5432,8008 -j ACCEPT
# The admins: SSH, PostgreSQL, Patroni's REST API
-A INPUT -s 10.9.0.0/24 -p tcp -m multiport --dports 22,5432,8008 -j ACCEPT
# This server's routers: BGP, BFD
-A INPUT -s 203.0.113.1/32 -p tcp --dport 179 -j ACCEPT
-A INPUT -s 203.0.113.1/32 -p udp --dport 3784 -j ACCEPT
-A INPUT -s 203.0.113.2/32 -p tcp --dport 179 -j ACCEPT
-A INPUT -s 203.0.113.2/32 -p udp --dport 3784 -j ACCEPT
COMMIT

--- out/west/files/etc/iptables/rules.v6 (600)
# rules.v6 - Made by yubikey-turnkey <VERSION> from site.toml.
# The firewall of west (IPv6), loaded by netfilter-persistent at boot.
# setup.sh installs it again whenever it differs: change site.toml instead.
*filter
