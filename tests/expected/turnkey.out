--- out/east1/files.list (600)
# files.list - Made by yubikey-turnkey <VERSION> from site.toml: the files setup.sh
# installs from files/, as STEP KIND MODE OWNER:GROUP POLICY PATH. POLICY
# replace: whenever they differ; keep: only when the file is missing (the
# anycast check changes its own).
system file 0644 root:root replace etc/sysctl.d/60-radiator-anycast.conf
etcd dir 0750 root:etcd - etc/etcd/tls
etcd file 0644 root:root replace etc/etcd/tls/ca.crt
etcd file 0644 root:root replace etc/etcd/tls/server.crt
etcd file 0640 root:etcd replace etc/etcd/tls/server.key
etcd file 0644 root:root replace etc/default/etcd
patroni dir 0750 root:postgres - etc/patroni/tls
patroni file 0644 root:root replace etc/patroni/tls/ca.crt
patroni file 0644 root:root replace etc/patroni/tls/server.crt
patroni file 0640 root:postgres replace etc/patroni/tls/server.key
patroni file 0640 root:postgres replace etc/patroni/18-main.yml
patroni file 0644 root:root replace etc/systemd/system/patroni@18-main.service.d/restart.conf
radiator file 0644 root:root replace etc/radiator/pg-ca.crt
radiator file 0640 root:radiator replace etc/radiator/radiator.conf
radiator dir 0750 root:radiator - etc/radiator/clients.d
radiator file 0640 root:radiator replace etc/radiator/clients.d/core.conf
radiator file 0640 root:radiator replace etc/radiator/clients.d/access.conf
radiator file 0640 root:radiator replace etc/radiator/clients.d/catch-all.conf
partition file 0644 root:root replace etc/radiator/partition.conf
anycast file 0600 root:root replace etc/radiator/anycast.conf
anycast dir 0700 root:root - var/lib/yubikey-anycast
anycast file 0600 root:root keep var/lib/yubikey-anycast/key
anycast file 0600 root:root keep var/lib/yubikey-anycast/counter
anycast file 0600 root:root keep var/lib/yubikey-anycast/tacacs
anycast file 0640 frr:frr replace etc/frr/frr.conf
backup file 0644 root:root replace etc/radiator/backup.crt
backup file 0644 root:root replace etc/radiator/backup.conf
backup file 0640 root:adm replace var/backups/yubikey-turnkey-secrets.toml.cms
firewall file 0644 root:root replace etc/iptables/rules.v4
firewall file 0644 root:root replace etc/iptables/rules.v6

