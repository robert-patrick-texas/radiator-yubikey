# core.conf - Made by yubikey-turnkey <VERSION> from site.toml.
# The devices in device group core.

# core1
<Client 10.1.0.1>
    Identifier     core
    Secret         DX2ZEinYf27szXsp9rXZqJvqBX6DfiXd
    TACACSPLUSKey  4n2N03CSEgtnSZ3rO04wb0jBSXcojgEF
</Client>

