VERSION="<VERSION>"
SITE_NAME="Example network"
NAME="west"
FQDN="west.example.com"
IPV4="203.0.113.33"
IPV6="2001:db8:33::33"
FIRST="east1"
SERVERS="east1 east2 west"
FQDNS="east1.example.com east2.example.com west.example.com"
IPV4S="192.0.2.31 198.51.100.32 203.0.113.33"
ANYCAST4="192.0.2.153"
ANYCAST6="2001:db8:153::153"
ADMINS="opsadmin"
ADMIN_SUBNETS="10.9.0.0/24 2001:db8:9::/64"
PARTITION="0"
FIREWALL="0"
BACKUP="1"

