[exit 1]

$ yubikey-db.sh bogus
yubikey-db.sh: error: unknown command 'bogus' (see 'yubikey-db.sh help')
[exit 1]

$ yubikey-db.sh --bogus-option list
yubikey-db.sh: error: unknown option '--bogus-option' (see 'yubikey-db.sh help')
[exit 1]

$ yubikey-db.sh -e rot13 list
yubikey-db.sh: error: --secret-encoding must be base64 or hex
[exit 1]

$ yubikey-db.sh -H md5 list
yubikey-db.sh: error: --password-hash must be crypt or clear
[exit 1]

