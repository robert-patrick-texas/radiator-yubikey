$ yubikey-db.sh -b mysql list
yubikey-db.sh: error: --backend must be sqlite or pg
[exit 1]

$ yubikey-db.sh init-pg
yubikey-db.sh: error: init-pg is for PostgreSQL; add -b pg
[exit 1]

$ PSQL=/nonexistent/psql yubikey-db.sh -b pg list
yubikey-db.sh: error: psql not found (install the postgresql-client package or set PSQL=/path/to/psql)
[exit 1]

$ PG_ADMIN_ROLE=Bad-Name yubikey-db.sh -b pg list
yubikey-db.sh: error: invalid admin role (PG_ADMIN_ROLE) 'Bad-Name' (use lowercase letters, digits and _, starting with a letter or _)
[exit 1]

$ PSQL=<WORK>/psql16 yubikey-db.sh -b pg -d yubikey init-pg
yubikey-db.sh: error: PostgreSQL 18 or later is required (this server runs 16.4)
[exit 1]

$ PSQL=<WORK>/psql16 yubikey-db.sh -b pg -d yubikey init
yubikey-db.sh: error: PostgreSQL 18 or later is required (this server runs 16.4)
[exit 1]

$ yubikey-db.sh -b pg config
# Sample Radiator <AuthBy SQLYUBIKEY> clause for PostgreSQL database yubikey
# (secret stored as base64; see the comments below)
<AuthBy SQLYUBIKEY>
    Identifier   YubiKeyLocal

    # Radiator on the database host connects over the local socket
    # (dbi:Pg:dbname=NAME). With peer authentication, the Ubuntu default,
    # Radiator must run as the OS user "radiator" and DBAuth stays empty.
    # Radiator on another host connects over TLS, for example
    #   dbi:Pg:dbname=NAME;host=db.example.com;port=5432;sslmode=verify-full
    # with DBAuth set to the radiator role's password (init-pg --set-password).
    # With a primary and a standby server, list both in one DBSource:
    #   host=db1.example.com,db2.example.com;target_session_attrs=read-write
    # libpq then connects to whichever server accepts writes, so Radiator
    # follows a promoted standby. Never list two independent databases:
    # each would keep its own counters, and an OTP used on one would be
    # accepted by the other.
    DBSource     dbi:Pg:dbname=yubikey
    DBUsername   radiator
    DBAuth

    # Give up quickly on a database server that does not answer, and try
    # again soon. Radiator's defaults wait up to 60 s for each query, and
    # when no server can be reached they reject every login for 600 s.
    # ConnectTimeout must cover connect_timeout for each listed server.
    Timeout             2
    ConnectTimeout      5
    FailureBackoffTime  10

    # Columns must come back in this order: secret, active, userId,
    # counter, session_use (low), ignored (high), static_password.
    # %0 = quoted username, %3 = token (public) ID in modhex.
    AuthSelect   select secret, active, userId, counter, low, high, password from yubikeys where username=%0 and tokenId=%3

    # %0 = counter, %1 = session use, %2 = 0, %3 = quoted username,
    # %5 = Unix time, %7 = token ID in modhex. Radiator's default
    # current_timestamp() is not valid in PostgreSQL, so %5 is used.
    UpdateQuery  update yubikeys set accessed=to_timestamp(%5), counter=%0, low=%1, high=%2 where username=%3 and tokenId=%7

    # Require2Factor: every login is the static password/PIN followed by the
    # OTP ("1234:OTP", or "1234OTP"), and a user with no stored password is
    # always rejected. Without it the OTP alone is accepted, even for users
    # who have a password; a password is checked only if one is entered.
    Require2Factor

    # Also check that the private ID in the OTP matches userId.
    CheckSecretId
</AuthBy>
[exit 0]

$ DB_BACKEND=pg yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey
    DBUsername   radiator
    ConnectTimeout      5

$ PGHOST=db.example.com yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey;host=db.example.com;port=5432;sslmode=verify-full;connect_timeout=2
    DBUsername   radiator
    ConnectTimeout      3

$ PGHOST=/var/run/postgresql yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey
    DBUsername   radiator
    ConnectTimeout      5

$ PGHOST=db.example.com PGPORT=6432 PGSSLMODE=require yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey;host=db.example.com;port=6432;sslmode=require;connect_timeout=2
    DBUsername   radiator
    ConnectTimeout      3

$ PGHOST=db.example.com PGSSLROOTCERT=/etc/radiator/pg-ca.crt yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey;host=db.example.com;port=5432;sslmode=verify-full;sslrootcert=/etc/radiator/pg-ca.crt;connect_timeout=2
    DBUsername   radiator
    ConnectTimeout      3

$ PGSERVICE=yubikey yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:service=yubikey
    DBUsername   radiator
    ConnectTimeout      5

$ PGSERVICE=yubikey PGDATABASE=radius yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=radius
    DBUsername   radiator
    ConnectTimeout      5

$ PG_RADIATOR_ROLE=radiusd yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey
    DBUsername   radiusd
    ConnectTimeout      5

$ PGHOST=db1.example.com,db2.example.com PGSSLROOTCERT=/etc/radiator/pg-ca.crt yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey;host=db1.example.com,db2.example.com;port=5432;sslmode=verify-full;sslrootcert=/etc/radiator/pg-ca.crt;connect_timeout=2;target_session_attrs=read-write
    DBUsername   radiator
    ConnectTimeout      5

$ PGHOST=db1,db2 PGCONNECT_TIMEOUT=3 PGTARGETSESSIONATTRS=primary yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
    DBSource     dbi:Pg:dbname=yubikey;host=db1,db2;port=5432;sslmode=verify-full;connect_timeout=3;target_session_attrs=primary
    DBUsername   radiator
    ConnectTimeout      7

$ PGCONNECT_TIMEOUT=0 yubikey-db.sh -b pg config | grep -E "DB|ConnectTimeout"
yubikey-db.sh: error: PGCONNECT_TIMEOUT must be 1 to 999 seconds (0 would wait for ever)

$ yubikey-db.sh -b pg -d radius config | grep DB
    DBSource     dbi:Pg:dbname=radius
    DBUsername   radiator

